{
  "name": "expo-invitation-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore ./data --ignore ./src server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --target=node18 --external:vite --outfile=dist-server/server.cjs",
    "start": "NODE_ENV=production node dist-server/server.cjs",
    "release": "npm run build && node scripts/release.mjs",
    "clean": "rm -rf dist dist-server release",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/changa": "^5.3.0",
    "@fontsource/lalezar": "^5.3.0",
    "@fontsource/mada": "^5.3.0",
    "@fontsource/markazi-text": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/reem-kufi": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^13.1.0",
    "jalaali-js": "^2.0.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.31.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/jalaali-js": "^1.2.0",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "qs": "^6.16.2"
  }
}
