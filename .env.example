# ---- Required in production ----

# Password for creating invitations, uploading files and the admin list.
# (Owners can still edit their own invitation with its private edit link.)
ADMIN_PASSWORD=

# ---- Paths & URLs ----

# URL prefix the app is served under. https://studio.asvashop.com/in/<slug>  ->  /in
# Must match the value used when building (npm run build reads it too).
BASE_PATH=/in

# Canonical public address, used in link previews (Telegram/WhatsApp).
PUBLIC_URL=https://studio.asvashop.com/in

# Where invitations (JSON) and uploaded files are stored. Use a folder OUTSIDE the app
# folder so redeploying never deletes data, and include it in your backups.
# Example (cPanel): /home/<cpanel-user>/expo-invite-data
DATA_DIR=

# Port (ignored under cPanel/Passenger, which assigns its own)
PORT=3000

# ---- Optional ----

# Which proxies to trust for the client IP (rate limiting): loopback | true | false | <ip/cidr>
TRUST_PROXY=loopback

# Total size limit for uploaded files (MB) and how long unused uploads are kept (days)
UPLOAD_QUOTA_MB=3000
UPLOAD_GRACE_DAYS=7

# Path to ffmpeg. If available, uploaded videos are converted to small MP4s that play on
# every phone, MOV files from iPhones are accepted, and poster frames are generated.
FFMPEG_PATH=ffmpeg

# Set to true ONLY if you really want anyone to create invitations without a password.
ALLOW_OPEN_ACCESS=false
